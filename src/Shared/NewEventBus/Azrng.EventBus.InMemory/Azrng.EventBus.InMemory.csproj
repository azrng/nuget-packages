<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <IsAotCompatible>true</IsAotCompatible>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Authors>Azrng</Authors>
        <Copyright>版权归Azrng所有</Copyright>
        <Description>一个学习eShop的自用事件总线内存版实现</Description>
        <!-- 1.2.0：处理器直投原事件对象（原为序列化往返副本）；新增处理器失败策略 -->
        <Version>1.2.0</Version>
        <PackageId>Azrng.EventBus.InMemory</PackageId>
        <RepositoryUrl>https://github.com/azrng/nuget-packages</RepositoryUrl>
        <NoWarn>1701;1702;1591</NoWarn>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Title>InMemory Event Bus</Title>
        <PackageTags>eventbus;inmemory;messaging;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.1"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Azrng.EventBus.Core\Azrng.EventBus.Core.csproj"/>
    </ItemGroup>

</Project>
