<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <!-- RabbitMQ.Client 6.x 不支持 Native AOT，不能声明 IsAotCompatible；Core/InMemory 才有该声明 -->
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Authors>Azrng</Authors>
        <Copyright>版权归Azrng所有</Copyright>
        <Description>一个学习eShop的自用事件总线RabbitMq实现</Description>
        <!-- 1.2.0：消费失败进死信队列（原为 ACK 丢弃）、发布 channel 复用、断线自动重连、配置校验 -->
        <Version>1.2.0</Version>
        <PackageId>Azrng.EventBus.RabbitMQ</PackageId>
        <RepositoryUrl>https://github.com/azrng/nuget-packages</RepositoryUrl>
        <NoWarn>1701;1702;1591</NoWarn>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Title>RabbitMQ Event Bus</Title>
        <PackageTags>eventbus;rabbitmq;messaging;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0"/>
        <PackageReference Include="Polly.Core" Version="8.5.2"/>
        <PackageReference Include="RabbitMQ.Client" Version="6.5.0"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.1"/>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.1"/>
        <PackageReference Include="Polly.Core" Version="8.5.2"/>
        <PackageReference Include="RabbitMQ.Client" Version="6.5.0"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0"/>
        <PackageReference Include="Polly.Core" Version="8.5.2"/>
        <PackageReference Include="RabbitMQ.Client" Version="6.5.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Azrng.EventBus.Core\Azrng.EventBus.Core.csproj"/>
    </ItemGroup>

</Project>